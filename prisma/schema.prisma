generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id              Int       @id @default(autoincrement())
  domain          String    @unique
  name            String
  themeConfig     Json?     @map("theme_config")
  contactInfo     Json?     @map("contact_info")
  defaultCurrency String?   @map("default_currency_id")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  invoices        Invoice[]
  users           User[]
  vehicles        Vehicle[]

  @@map("sites")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  name              String?
  password          String
  phone             String?
  country           String?
  department        String?
  role              UserRole          @default(USER)
  status            UserStatus        @default(ACTIVE)
  emailVerified     DateTime?         @map("email_verified")
  image             String?
  siteId            Int?              @map("site_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  accounts          Account[]
  bookings          Booking[]
  cartItems         CartItem[]
  dealerProfile     DealerProfile?
  inquiriesManaged  Inquiry[]         @relation("InquiryManager")
  inquiriesAsDealer Inquiry[]         @relation("InquiryDealer")
  inquiriesSent     Inquiry[]         @relation("InquiryUser")
  inquiryResponses  InquiryResponse[]
  invoices          Invoice[]
  sessions          Session[]
  site              Site?             @relation(fields: [siteId], references: [id])
  wishlists         Wishlist[]

  @@index([email])
  @@index([siteId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Vehicle {
  id               Int               @id @default(autoincrement())
  siteId           Int               @map("site_id")
  stockNumber      String            @map("stock_number")
  vinChassis       String?           @map("vin_chassis")
  make             String
  model            String
  yearManufacture  Int               @map("year_manufacture")
  yearRegistration Int?              @map("year_registration")
  priceFob         Decimal           @map("price_fob") @db.Decimal(12, 2)
  priceRetail      Decimal?          @map("price_retail") @db.Decimal(12, 2)
  currency         String?           @default("JPY") @map("currency")
  description      String?           @map("description")
  status           VehicleStatus     @default(AVAILABLE)
  featured         Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  bookings         Booking[]
  cartItems        CartItem[]
  inquiries        Inquiry[]
  invoices         Invoice[]
  images           VehicleImage[]
  logistics        VehicleLogistics?
  specs            VehicleSpec?
  documents        VehicleDocument[]
  history          VehicleHistory?
  site             Site              @relation(fields: [siteId], references: [id])
  wishlists        Wishlist[]

  @@index([siteId])
  @@index([make])
  @@index([status])
  @@index([featured])
  @@map("vehicles")
}

model VehicleSpec {
  id               Int      @id @default(autoincrement())
  vehicleId        Int      @unique @map("vehicle_id")
  engineCode       String?  @map("engine_code")
  engineCc         Int?     @map("engine_cc")
  fuelType         String?  @map("fuel_type")
  transmission     String?
  driveType        String?  @map("drive_type")
  steering         String?
  seats            Int?
  doors            Int?
  colorExterior    String?  @map("color_exterior")
  colorInterior    String?  @map("color_interior")
  trimGrade        String?  @map("trim_grade")
  mileageKm        Int?     @map("mileage_km")
  vehicleType      String?  @map("vehicle_type")
  // Engine performance
  powerKw          Int?     @map("power_kw")
  powerHp          Int?     @map("power_hp")
  torqueNm         Int?     @map("torque_nm")
  // Weight & dimensions (for display; shipping dimensions live in VehicleLogistics)
  weightKg         Int?     @map("weight_kg")
  dimensions       String?  @map("dimensions") // e.g. "4690×1730×1315"
  // Economy & emissions
  fuelConsumption  String?  @map("fuel_consumption") // e.g. "15.6 km/L"
  emissionStandard String?  @map("emission_standard") // e.g. "Euro 5"
  options          Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_specs")
}

model VehicleLogistics {
  id               Int       @id @default(autoincrement())
  vehicleId        Int       @unique @map("vehicle_id")
  // Shipping dimensions
  lengthCm         Int?      @map("length_cm")
  widthCm          Int?      @map("width_cm")
  heightCm         Int?      @map("height_cm")
  m3               Decimal?  @db.Decimal(5, 2)
  weightKg         Int?      @map("weight_kg")
  // Port information
  currentPortId    String?   @map("current_port_id")
  currentPortName  String?   @map("current_port_name")
  originCountry    String?   @map("origin_country")
  originPort       String?   @map("origin_port")
  // Customs & compliance
  hsCode           String?   @map("hs_code")
  exportCertStatus Boolean   @default(false) @map("export_cert_status")
  // Inspection & shipping
  inspectionStatus String?   @map("inspection_status")
  inspectionDate   DateTime? @map("inspection_date")
  importDate       DateTime? @map("import_date")
  shippingStatus   String?   @map("shipping_status")
  etaDestination   DateTime? @map("eta_destination")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_logistics")
}

model VehicleImage {
  id        Int      @id @default(autoincrement())
  vehicleId Int      @map("vehicle_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Invoice {
  id               Int           @id @default(autoincrement())
  siteId           Int           @map("site_id")
  vehicleId        Int           @map("vehicle_id")
  userId           Int           @map("user_id")
  invoiceNumber    String        @unique @map("invoice_number")
  currencyCode     String        @map("currency_code")
  amountFob        Decimal       @map("amount_fob") @db.Decimal(12, 2)
  amountFreight    Decimal       @map("amount_freight") @db.Decimal(12, 2)
  amountInsurance  Decimal       @map("amount_insurance") @db.Decimal(12, 2)
  amountInspection Decimal       @map("amount_inspection") @db.Decimal(12, 2)
  amountTotal      Decimal       @map("amount_total") @db.Decimal(12, 2)
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  consigneeDetails Json?         @map("consignee_details")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  site             Site          @relation(fields: [siteId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([siteId])
  @@index([userId])
  @@map("invoices")
}

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  symbol    String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("currencies")
}

model Port {
  id            Int      @id @default(autoincrement())
  name          String
  country       String
  region        String?
  isDestination Boolean  @default(false) @map("is_destination")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ports")
}

model DealerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  businessName    String?  @map("business_name")
  description     String?
  logo            String?
  coverImage      String?  @map("cover_image")
  rating          Decimal? @db.Decimal(3, 2)
  totalSales      Int      @default(0) @map("total_sales")
  yearsInBusiness Int?     @map("years_in_business")
  address         String?
  website         String?
  publicEmail     String?  @map("public_email")
  publicPhone     String?  @map("public_phone")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dealer_profiles")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vehicleId Int      @map("vehicle_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([vehicleId])
  @@map("wishlists")
}

model CartItem {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  vehicleId Int        @map("vehicle_id")
  quantity  Int        @default(1)
  status    CartStatus @default(ACTIVE)
  expiresAt DateTime?  @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([status])
  @@map("cart_items")
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  vehicleId     Int           @map("vehicle_id")
  bookingNumber String        @unique @map("booking_number")
  status        BookingStatus @default(PENDING)
  bookingAmount Decimal       @map("booking_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  expiresAt     DateTime      @map("expires_at")
  confirmedAt   DateTime?     @map("confirmed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  buyerNotes    String?       @map("buyer_notes")
  adminNotes    String?       @map("admin_notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@map("bookings")
}

model Inquiry {
  id         Int               @id @default(autoincrement())
  userId     Int               @map("user_id")
  assignedTo Int?              @map("assigned_to")
  vehicleId  Int?              @map("vehicle_id")
  dealerId   Int?              @map("dealer_id")
  type       InquiryType       @default(GENERAL)
  status     InquiryStatus     @default(OPEN)
  subject    String
  message    String
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  manager    User?             @relation("InquiryManager", fields: [assignedTo], references: [id])
  dealer     User?             @relation("InquiryDealer", fields: [dealerId], references: [id])
  user       User              @relation("InquiryUser", fields: [userId], references: [id])
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id])
  responses  InquiryResponse[]

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
  @@map("inquiries")
}

model InquiryResponse {
  id        Int      @id @default(autoincrement())
  inquiryId Int      @map("inquiry_id")
  userId    Int      @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([inquiryId])
  @@map("inquiry_responses")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
  DEALER
  SUPPLIER
  BUYER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  SHIPPED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum CartStatus {
  ACTIVE
  EXPIRED
  CONVERTED_TO_BOOKING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  CONVERTED_TO_SALE
}

enum InquiryType {
  GENERAL
  VEHICLE_INQUIRY
  DEALER_CONTACT
  SUPPORT
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================
// VEHICLE DOCUMENTS & HISTORY
// ============================================

enum DocumentType {
  TITLE
  INSPECTION
  EXPORT_CERT
  CUSTOMS
  AUCTION_SHEET
  SERVICE_RECORD
  OTHER
}

model VehicleDocument {
  id        Int          @id @default(autoincrement())
  vehicleId Int          @map("vehicle_id")
  type      DocumentType @default(OTHER)
  title     String?      @map("title")
  url       String       @map("url")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@map("vehicle_documents")
}

model VehicleHistory {
  id              Int      @id @default(autoincrement())
  vehicleId       Int      @unique @map("vehicle_id")
  previousOwners  String?  @map("previous_owners")  // Free text, e.g. "2 owners (corporate)"
  serviceHistory  String?  @map("service_history")   // Summary of service records
  accidentHistory String?  @map("accident_history")  // e.g. "No accidents reported"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_history")
}
