// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY
// ============================================

model Site {
  id              String    @id @default(cuid())
  domain          String    @unique
  name            String
  themeConfig     Json?     @map("theme_config")
  contactInfo     Json?     @map("contact_info")
  defaultCurrency String?   @map("default_currency_id")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  users           User[]
  vehicles        Vehicle[]
  invoices        Invoice[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("sites")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  BUYER
  DEALER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // bcrypt hashed
  phone         String?
  country       String?
  role          UserRole  @default(BUYER)
  emailVerified DateTime? @map("email_verified")
  image         String?
  siteId        String?   @map("site_id")
  
  // Relations
  site          Site?     @relation(fields: [siteId], references: [id])
  invoices      Invoice[]
  sessions      Session[]
  accounts      Account[]
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  @@index([email])
  @@index([siteId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// VEHICLES & INVENTORY
// ============================================

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  SHIPPED
}

model Vehicle {
  id                String         @id @default(cuid())
  siteId            String         @map("site_id")
  stockNumber       String         @map("stock_number")
  vinChassis        String?        @map("vin_chassis")
  make              String
  model             String
  yearManufacture   Int            @map("year_manufacture")
  yearRegistration  Int?           @map("year_registration")
  priceFob          Decimal        @map("price_fob") @db.Decimal(12, 2)
  status            VehicleStatus  @default(AVAILABLE)
  featured          Boolean        @default(false)
  
  // Relations
  site              Site           @relation(fields: [siteId], references: [id])
  specs             VehicleSpec?
  logistics         VehicleLogistics?
  images            VehicleImage[]
  invoices          Invoice[]
  
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  
  @@index([siteId])
  @@index([make])
  @@index([status])
  @@index([featured])
  @@map("vehicles")
}

model VehicleSpec {
  id              String   @id @default(cuid())
  vehicleId       String   @unique @map("vehicle_id")
  engineCode      String?  @map("engine_code")
  engineCc        Int?     @map("engine_cc")
  fuelType        String?  @map("fuel_type")
  transmission    String?
  driveType       String?  @map("drive_type")
  steering        String?
  seats           Int?
  doors           Int?
  colorExterior   String?  @map("color_exterior")
  colorInterior   String?  @map("color_interior")
  trimGrade       String?  @map("trim_grade")
  mileageKm       Int?     @map("mileage_km")
  vehicleType     String?  @map("vehicle_type")
  options         Json?
  
  // Relations
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("vehicle_specs")
}

model VehicleLogistics {
  id                  String   @id @default(cuid())
  vehicleId           String   @unique @map("vehicle_id")
  lengthCm            Int?     @map("length_cm")
  widthCm             Int?     @map("width_cm")
  heightCm            Int?     @map("height_cm")
  m3                  Decimal? @db.Decimal(5, 2)
  weightKg            Int?     @map("weight_kg")
  currentPortId       String?  @map("current_port_id")
  originCountry       String?  @map("origin_country")
  hsCode              String?  @map("hs_code")
  inspectionStatus    String?  @map("inspection_status")
  exportCertStatus    Boolean  @default(false) @map("export_cert_status")
  
  // Relations
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@map("vehicle_logistics")
}

model VehicleImage {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  url         String
  altText     String?  @map("alt_text")
  order       Int      @default(0)
  isPrimary   Boolean  @default(false) @map("is_primary")
  
  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([vehicleId])
  @@map("vehicle_images")
}

// ============================================
// SALES & INVOICES
// ============================================

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model Invoice {
  id                String        @id @default(cuid())
  siteId            String        @map("site_id")
  vehicleId         String        @map("vehicle_id")
  userId            String        @map("user_id")
  invoiceNumber     String        @unique @map("invoice_number")
  currencyCode      String        @map("currency_code")
  amountFob         Decimal       @map("amount_fob") @db.Decimal(12, 2)
  amountFreight     Decimal       @map("amount_freight") @db.Decimal(12, 2)
  amountInsurance   Decimal       @map("amount_insurance") @db.Decimal(12, 2)
  amountInspection  Decimal       @map("amount_inspection") @db.Decimal(12, 2)
  amountTotal       Decimal       @map("amount_total") @db.Decimal(12, 2)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  consigneeDetails  Json?         @map("consignee_details")
  
  // Relations
  site              Site          @relation(fields: [siteId], references: [id])
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  
  @@index([siteId])
  @@index([userId])
  @@map("invoices")
}

// ============================================
// GLOBAL REFERENCE DATA
// ============================================

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  symbol    String
  name      String
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("currencies")
}

model Port {
  id            String   @id @default(cuid())
  name          String
  country       String
  region        String?
  isDestination Boolean  @default(false) @map("is_destination")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  @@map("ports")
}
