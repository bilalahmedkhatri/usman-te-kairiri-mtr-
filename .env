# Database Connection
# Note: Use 'postgres' as host when running in Docker, 'localhost' when running locally
DATABASE_URL="postgresql://car_export_user:car_export_password@localhost:5432/car_export_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production-use-openssl-rand-base64-32"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Optional: Email Service (for future use)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Optional: OAuth Providers (for future use)
